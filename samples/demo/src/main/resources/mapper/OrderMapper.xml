<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.order.dao.OrderMapper">

    <sql id="merchantScope">merchant_id = #{merchantId}</sql>

    <select id="queryOrder" resultType="map">
        SELECT * FROM orders
        WHERE <include refid="merchantScope"/>
          AND status = #{status}
    </select>

    <select id="queryByPositional" resultType="map">
        SELECT * FROM orders WHERE status = #{param2}
    </select>

    <select id="queryByMap" resultType="map">
        SELECT * FROM orders
        <where>
            <include refid="merchantScope"/>
        </where>
    </select>

    <update id="updateStatus">
        UPDATE orders SET status = #{status} WHERE id = #{id}
    </update>

    <select id="queryByBean" resultType="map">
        SELECT * FROM orders WHERE merchant_id = #{merchantId}
        <if test="poiId != null">AND poi_id = #{poiId}</if>
    </select>
</mapper>
